load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# `bazel run //example:up` — the two targets every request in this collection points at.
sh_binary(
    name = "up",
    srcs = ["//tools:example-up.sh"],
    args = [
        "$(rootpath //service/echo/cmd)",
        "$(rootpath //service/cmd/dev)",
        "$(rootpath //service/cmd:grpcview)",
    ],
    data = [
        "//service/cmd:grpcview",
        "//service/cmd/dev",
        "//service/echo/cmd",
    ],
)
