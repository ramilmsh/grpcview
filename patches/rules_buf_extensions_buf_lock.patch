     "sha256": attr.string(doc = "The checksum sha256.txt file"),
 })
 
+def _parse_buf_lock(contents):
+    pins = []
+    reading_deps = False
+    current_name = ""    
+    current_commit = ""   
+    for line in contents.split("\n"):
+        stripped = line.strip()
+        if stripped == "deps:":
+            reading_deps = True
+            continue
+        if not reading_deps:
+            continue
+        
+        if stripped.startswith("-"):
+            if current_name != "" and current_commit != "":
+                pins.append("{}:{}".format(current_name, current_commit))
+            current_name = ""
+            current_commit = ""
+            stripped = stripped[1:].strip()
+        
+        if stripped.startswith("name:"):
+            current_name = stripped.split("name:")[1].strip()
+            continue
+        if stripped.startswith("commit:"):
+            current_commit = stripped.split("commit:")[1].strip()
+            continue
+
+    # Flush the last entry: the loop above only flushes on the *next* "-",
+    # so without this the final (or only) dep in the file is silently dropped.
+    if current_name != "" and current_commit != "":
+        pins.append("{}:{}".format(current_name, current_commit))
+
+    return pins
+
 def _extension_impl(module_ctx):
