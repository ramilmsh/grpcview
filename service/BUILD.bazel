load("@aspect_bazel_lib//lib:copy_file.bzl", "copy_file")
load("@rules_go//go:def.bzl", "go_library", "go_test")

copy_file(
    name = "ui",
    src = "//ui",
    out = "index.html",
)

go_library(
    name = "service",
    srcs = [
        "idle.go",
        "logging.go",
        "service.go",
    ],
    importpath = "codeberg.org/ramilmsh/grpcview/service",
    visibility = ["//visibility:public"],
    deps = [
        "//grpcview/v1:grpcview",
        "//service/daemon",
        "//service/workspace",
        "//service/wsroot",
        "@com_connectrpc_connect//:connect",
        "@com_connectrpc_cors//:cors",
        "@com_connectrpc_grpcreflect//:grpcreflect",
        "@com_github_rs_cors//:cors",
        "@org_golang_google_genproto_googleapis_rpc//status",
        "@org_golang_google_protobuf//types/known/durationpb",
        "@org_golang_x_net//http2",
        "@org_golang_x_net//http2/h2c",
    ],
)

go_test(
    name = "service_test",
    srcs = [
        "idle_test.go",
        "logging_test.go",
        "service_test.go",
    ],
    embed = [":service"],
    deps = [
        "//grpcview/v1:grpcview",
        "//service/daemon",
        "@com_connectrpc_connect//:connect",
    ],
)
