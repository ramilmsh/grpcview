load("@protobuf//bazel:proto_descriptor_set.bzl", "proto_descriptor_set")
load("@rules_go//go:def.bzl", "go_library", "go_test")

proto_descriptor_set(
    name = "descriptor_set",
    deps = ["//grpcview/v1:grpcviewv1_proto"],
)

go_library(
    name = "mcp",
    srcs = [
        "collection.go",
        "descriptor.go",
        "dispatch.go",
        "mcp.go",
        "schema.go",
        "streaming.go",
        "trim.go",
    ],
    # keep
    embedsrcs = [":descriptor_set"],
    importpath = "codeberg.org/ramilmsh/grpcview/service/mcp",
    visibility = ["//visibility:public"],
    deps = [
        "//grpcview/v1:grpcviewv1_go_proto",
        "//service/wire",
        "@com_connectrpc_connect//:connect",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@com_github_redpanda_data_protoc_gen_go_mcp//pkg/gen",
        "@com_github_redpanda_data_protoc_gen_go_mcp//pkg/runtime",
        "@com_github_redpanda_data_protoc_gen_go_mcp//pkg/runtime/gosdk",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protodesc",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//reflect/protoregistry",
        "@org_golang_google_protobuf//types/descriptorpb",
    ],
)

go_test(
    name = "mcp_test",
    srcs = [
        "mcp_test.go",
        "schema_test.go",
        "streaming_test.go",
    ],
    embed = [":mcp"],
    deps = [
        "//grpcview/v1:grpcviewv1_go_proto",
        "//service/workspace",
        "@com_github_redpanda_data_protoc_gen_go_mcp//pkg/gen",
        "@com_github_redpanda_data_protoc_gen_go_mcp//pkg/runtime",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//reflect/protodesc",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//types/descriptorpb",
    ],
)
