load("@aspect_bazel_lib//lib:copy_file.bzl", "copy_file")
load("@rules_go//go:def.bzl", "go_library", "go_test")

# Bring the compiled engine into this package as quickjs.wasm so engine.go can
# //go:embed it by basename, mirroring how //service/cmd embeds index.html. The
# result is still a single static pure-Go binary — the .wasm rides inside it.
copy_file(
    name = "quickjs_wasm",
    src = "//third_party/quickjs:quickjs.wasm",
    out = "quickjs.wasm",
)

go_library(
    name = "scripting",
    srcs = [
        "bundler.go",
        "engine.go",
        "entry.go",
        "marshal.go",
        "npm.go",
        "pool.go",
        "profiles.go",
        "sourcemap.go",
    ],
    # quickjs.wasm is the engine; npm/** is the embedded npm registry (dayjs) the Engine
    # self-provisions so bare npm imports resolve offline in the shipped binary.
    embedsrcs = ["quickjs.wasm"] + glob(["npm/**"]),
    importpath = "codeberg.org/ramilmsh/grpcview/service/scripting",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_evanw_esbuild//pkg/api",
        "@com_github_tetratelabs_wazero//:wazero",
        "@com_github_tetratelabs_wazero//api",
        "@com_github_tetratelabs_wazero//imports/wasi_snapshot_preview1",
    ],
)

go_test(
    name = "scripting_test",
    srcs = [
        "bundler_test.go",
        "capabilities_test.go",
        "engine_core_test.go",
        "entry_test.go",
        "wasm_smoke_test.go",
    ],
    # Vendored npm packages (dayjs/mustache/ms) + entry package.jsons, embedded into the
    # test binary so the esbuild-bundling validation is hermetic (no node_modules, no net).
    embedsrcs = glob(["testdata/npm/**"]),
    embed = [":scripting"],
)
