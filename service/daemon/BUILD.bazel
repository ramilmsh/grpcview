load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "daemon",
    srcs = [
        "browser.go",
        "connect.go",
        "lock.go",
        "registration.go",
    ],
    importpath = "codeberg.org/ramilmsh/grpcview/service/daemon",
    visibility = ["//visibility:public"],
    deps = [
        "//grpcview/v1:grpcviewv1_go_proto",
        "//service/wsroot",
        "@com_connectrpc_connect//:connect",
    ],
)

go_test(
    name = "daemon_test",
    srcs = [
        "connect_test.go",
        "registration_test.go",
    ],
    embed = [":daemon"],
    deps = [
        "//grpcview/v1:grpcviewv1_go_proto",
        "@com_connectrpc_connect//:connect",
    ],
)
