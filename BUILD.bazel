#gazelle:resolve go go github.com/bytecodealliance/wasmtime-go/v30 @com_github_bytecodealliance_wasmtime_go_v30//:go_default_library

gazelle(name = "gazelle")

npm_link_all_packages(name = "node_modules")

vite_bin.vite_binary(
    name = "vite",
    chdir = package_name(),
    data = ["//:node_modules"],
)

