"""
grpcview
"""

module(name = "grpcview")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "bazel_env.bzl", version = "0.8.0")
bazel_dep(name = "buildozer", version = "8.5.1")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.2.0")

# Forced on in .bazelrc (build:macos) over hermetic_cc_toolchain's zig darwin toolchain,
# which can't compile for macOS. Declared directly so .bazelrc's canonical-name reference
# to its cc toolchains stays valid.
bazel_dep(name = "apple_support", version = "1.24.2")

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")

# //third_party/quickjs invokes `zig cc` DIRECTLY (via @zig_sdk//:zig) to build the
# wasm32-wasi module: no wasm cc toolchain is registered for resolution.
use_repo(toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain/...",
    "@zig_sdk//libc_aware/toolchain/...",
)

# Pinned bellard/quickjs C source, compiled to wasm by //third_party/quickjs.
quickjs = use_extension("//third_party/quickjs:extensions.bzl", "quickjs")
use_repo(quickjs, "quickjs")

# Ships a prebuilt protoc toolchain, so protoc is downloaded rather than compiled; the
# *_WAS_NOT_SUPPOSED_TO_BE_BUILT copt guards in .bazelrc fail the build if it ever is.
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "rules_buf", version = "0.5.4")

# Adds buf.dependencies(buf_lock = ...), letting the extension read BSR module
# pins straight out of //:buf.lock instead of repeating them here, so buf.yaml
# (used by the Buf CLI/IDE) stays the single source of truth.
# See patches/README.md and https://github.com/bufbuild/rules_buf/issues/131.
single_version_override(
    module_name = "rules_buf",
    patch_strip = 1,
    patches = [
        "//patches:rules_buf_extensions_buf_lock.patch",
        "//patches:rules_buf_repo_proto_package_mode.patch",
    ],
)

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(version = "v1.61.0")
buf.dependencies(buf_lock = ["//:buf.lock"])
use_repo(buf, "buf_deps", "rules_buf_toolchains")

bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_go", version = "0.61.1")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "aspect_gazelle_prebuilt", version = "0.0.25")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    version = "1.26.5",
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# The module ships its own BUILD files; "clean" makes gazelle regenerate them.
go_deps.gazelle_override(
    build_file_generation = "clean",
    path = "github.com/redpanda-data/protoc-gen-go-mcp",
)
use_repo(
    go_deps,
    # `bazel mod tidy` proposes dropping this one — it only tracks Go-import-based
    # usage, and this repo is consumed solely as a string label in tools/BUILD.bazel's
    # `aspect_gazelle`'s `repo_config` attr, which it can't see. Removing it breaks
    # //tools:gazelle ("no repository visible as '@bazel_gazelle_go_repository_config'").
    "bazel_gazelle_go_repository_config",
    "com_connectrpc_connect",
    "com_connectrpc_cors",
    "com_connectrpc_grpcreflect",
    "com_github_evanw_esbuild",
    "com_github_go_git_go_git_v5",
    "com_github_jhump_protoreflect",
    "com_github_modelcontextprotocol_go_sdk",
    "com_github_redpanda_data_protoc_gen_go_mcp",
    "com_github_rs_cors",
    "com_github_spf13_cobra",
    "com_github_tetratelabs_wazero",
    "org_golang_google_genproto_googleapis_rpc",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_net",
)

bazel_dep(name = "aspect_rules_ts", version = "3.9.1")
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "aspect_rules_esbuild", version = "0.27.0")
bazel_dep(name = "aspect_rules_swc", version = "2.7.6")
bazel_dep(name = "rules_nodejs", version = "6.7.5")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm", dev_dependency = True)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", dev_dependency = True)
npm.npm_translate_lock(
    name = "npm",
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

# ts_project resolves its tsc toolchain from the "typescript" devDependency
# declared in ui/package.json via this extension, rather than a separately
# pinned version here.
rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext", dev_dependency = True)
rules_ts_ext.deps()
use_repo(rules_ts_ext, "npm_typescript")

bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")

buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")

bazel_dep(name = "rules_multitool", version = "1.11.1")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(
    lockfile = "//tools:multitool.lock.json",
)
use_repo(multitool, "multitool")

bazel_dep(name = "aspect_rules_lint", version = "2.8.0")
