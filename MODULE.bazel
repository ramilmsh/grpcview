"""
grpcview
"""

module(name = "grpcview")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "bazel_env.bzl", version = "0.8.0")
bazel_dep(name = "buildozer", version = "8.5.1")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.2.0")

# Native Apple cc toolchain, forced on the macOS host in .bazelrc (build:macos) so it
# wins over hermetic_cc_toolchain's zig darwin toolchain, which can't compile for macOS.
# Declared directly (also pulled transitively by protobuf) so the .bazelrc reference to
# @@apple_support++apple_cc_configure_extension+local_config_apple_cc_toolchains stays valid.
bazel_dep(name = "apple_support", version = "1.24.2")

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")

# //third_party/quickjs invokes `zig cc` DIRECTLY (via @zig_sdk//:zig) to build the
# wasm32-wasi module — no wasm cc toolchain is registered for resolution, so we drive
# the compiler as a plain build tool. Its wasm support files live in the sibling
# @zig_config repo, which this extension does not advertise as a root dep; that genrule
# therefore references them by canonical name so `bazel mod tidy` cannot strip them.
use_repo(toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain/...",
    "@zig_sdk//libc_aware/toolchain/...",
)

# Pinned bellard/quickjs C source, compiled to wasm by //third_party/quickjs.
quickjs = use_extension("//third_party/quickjs:extensions.bzl", "quickjs")
use_repo(quickjs, "quickjs")

# protobuf >= 33.4 ships its own prebuilt protoc binary toolchain, so protoc is downloaded
# rather than compiled from source. It is selected by --@protobuf//bazel/flags:prefer_prebuilt_protoc,
# which defaults to true from v34 onwards; toolchain resolution is enabled by default in Bazel 9
# (and pinned in .bazelrc). This replaces the archived toolchains_protoc module. The
# *_WAS_NOT_SUPPOSED_TO_BE_BUILT copt guards in .bazelrc fail the build if protoc is ever
# compiled from source, keeping us honest.
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "rules_buf", version = "0.5.4")

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(version = "v1.61.0")
use_repo(buf, "rules_buf_toolchains")

bazel_dep(name = "googleapis", version = "0.0.0-20260623-b6f9ff05")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "rules_go", version = "0.61.1")
bazel_dep(name = "gazelle", version = "0.51.3")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    version = "1.26.5",
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_connectrpc_connect",
    "com_connectrpc_cors",
    "com_connectrpc_grpcreflect",
    "com_github_invopop_jsonschema",
    "com_github_jhump_protoreflect",
    "com_github_rs_cors",
    "com_github_tetratelabs_wazero",
    "org_golang_google_genproto_googleapis_rpc",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_net",
)

bazel_dep(name = "aspect_rules_ts", version = "3.9.1")
bazel_dep(name = "aspect_rules_js", version = "3.2.3")
bazel_dep(name = "rules_nodejs", version = "6.7.5")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm", dev_dependency = True)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", dev_dependency = True)
npm.npm_translate_lock(
    name = "npm",
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4")

buildbuddy = use_extension("@toolchains_buildbuddy//:extensions.bzl", "buildbuddy")

bazel_dep(name = "rules_multitool", version = "1.11.1")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(
    lockfile = "//tools:multitool.lock.json",
)
use_repo(multitool, "multitool")
