diff --git a/dtoa.c b/dtoa.c
index ac1be8d..212ad47 100644
--- a/dtoa.c
+++ b/dtoa.c
@@ -30,7 +30,11 @@
 #include <ctype.h>
 #include <sys/time.h>
 #include <math.h>
+#if !defined(__wasi__)
+/* Unused in dtoa.c; wasi-musl's <setjmp.h> hard-#errors without the wasm
+ * exception-handling proposal, so skip the dead include under wasm32-wasi. */
 #include <setjmp.h>
+#endif
 
 #include "cutils.h"
 #include "dtoa.h"
diff --git a/quickjs.c b/quickjs.c
index fa5a7a9..b770037 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -32,6 +32,12 @@
 #include <time.h>
 #include <fenv.h>
 #include <math.h>
+#if defined(__wasi__)
+/* wasi-libc declares malloc_usable_size only in <malloc.h>, which quickjs.c does
+ * not otherwise pull in; needed by js_def_malloc_usable_size's default branch so
+ * JS_SetMemoryLimit accounting stays exact under wasm32-wasi. */
+#include <malloc.h>
+#endif
 #if defined(__APPLE__)
 #include <malloc/malloc.h>
 #elif defined(__linux__) || defined(__GLIBC__)
@@ -68,12 +74,19 @@
 
 /* define to include Atomics.* operations which depend on the OS
    threads */
-#if !defined(__EMSCRIPTEN__)
+#if !defined(__EMSCRIPTEN__) && !defined(__wasi__)
+/* wasm32-wasi is single-threaded and has no pthreads; Atomics/SharedArrayBuffer
+ * are also unwanted in the untrusted single-instance sandbox, so leave them out. */
 #define CONFIG_ATOMICS
 #endif
 
-#if !defined(__EMSCRIPTEN__)
+#if !defined(__EMSCRIPTEN__) && !defined(__wasi__)
 /* enable stack limitation */
+/* Off under wasm32-wasi (as under emscripten): QuickJS's js_get_stack_pointer()
+ * probe assumes a native downward C stack, but wasm's shadow stack makes every
+ * js_check_stack_overflow() read spurious, so JS_CallInternal would throw on the
+ * first call. wazero still contains runaway recursion by trapping on wasm stack
+ * exhaustion. */
 #define CONFIG_STACK_CHECK
 #endif
 
