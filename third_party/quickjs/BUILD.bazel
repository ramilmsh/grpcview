# Kept: `zig cc` is invoked directly here rather than through cc_toolchain
# resolution, because the root module only registers host-platform cc toolchains
# (which forces the Apple toolchain on macOS) and can't target wasm32-wasi-musl.
# Routing this through normal toolchain resolution would look like the "correct"
# fix but silently breaks the macOS-host / Linux-RBE build. See
# docs/design/shipped/quickjs-wasm-spike.md.

exports_files(["qjs_wasm.c"])

# buildifier: disable=canonical-repository
genrule(
    name = "quickjs_wasm",
    srcs = [
        "@quickjs//:core_srcs",
        "@quickjs//:headers",
        "qjs_wasm.c",
    ],
    outs = ["quickjs.wasm"],
    cmd = """
set -eu
export ZIG_GLOBAL_CACHE_DIR="$$(mktemp -d)"
export ZIG_LOCAL_CACHE_DIR="$$ZIG_GLOBAL_CACHE_DIR"
qjs_inc="$$(dirname $$(echo $(execpaths @quickjs//:core_srcs) | cut -d' ' -f1))"
$(execpath @zig_sdk//:zig) cc \
    -target wasm32-wasi \
    -mexec-model=reactor \
    -Oz \
    -Wl,--strip-all \
    -Wl,--initial-memory=2097152 \
    -Wl,-z,stack-size=1048576 \
    -DCONFIG_VERSION='"2026-06-04"' \
    -I "$$qjs_inc" \
    $(execpaths @quickjs//:core_srcs) \
    $(execpath qjs_wasm.c) \
    -o $@
""",
    tools = [
        "@@hermetic_cc_toolchain++toolchains+zig_config//:wasm32-wasi-musl_all_files",
        "@zig_sdk//:zig",
    ],
    visibility = ["//visibility:public"],
)
