load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@bazel_skylib//rules:write_file.bzl", "write_file")

# A named + linked library, modeled on e2e/npm-links/lib. Consumed only through
# the node_modules symlink //:npm-link-example/escape-lib creates -- see
# //consumer:BUILD.bazel.
npm_package(
    name = "npm_package",
    srcs = [
        "src/escape-lib.js",
        ":_package_json",
    ],
    package = "@e2e/escape-lib",
    visibility = ["//visibility:public"],
)

write_file(
    name = "_package_json",
    out = "package.json",
    content = ["""{"name": "@e2e/escape-lib", "main": "./src/escape-lib.js"}"""],
    visibility = ["//visibility:public"],
)
