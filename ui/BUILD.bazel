# gazelle:map_kind ts_project ts_project //ui:defs.bzl
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//ui:tsconfig-to-swcconfig/package_json.bzl", tsconfig_to_swcconfig = "bin")

npm_link_all_packages(name = "node_modules")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__subpackages__"],
)

# Generates .swcrc from tsconfig.json (rather than hand-syncing a second, separate
# config) so every ts_project's transpiler = partial.make(swc, swcrc = "//ui:.swcrc")
# across ui/src/... stays consistent with tsconfig.json's target/jsx/decorators
# options. See aspect_rules_swc's examples/generate_swcrc for this pattern.
tsconfig_to_swcconfig.t2s(
    name = "write_swcrc",
    srcs = ["tsconfig.json"],
    args = [
        "--filename",
        "$(location tsconfig.json)",
    ],
    stdout = ".swcrc",
    visibility = [":__subpackages__"],
)
