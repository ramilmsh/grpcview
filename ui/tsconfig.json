{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    // Every gazelle-generated ts_project locks declaration=true (see BUILD.bazel
    // "# keep" comments) so sibling ts_project targets can type-check @/*
    // path-aliased cross-package imports against .d.ts output; rules_ts
    // validates the attribute against this file, so it's mirrored here too.
    "declaration": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // TS 5.x deprecates baseUrl ahead of removing it in 7.0; paths below are
    // already written relative to this file's own directory (ui/), which is
    // baseUrl:"."'s exact behavior, so silencing rather than restructuring.
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@grpcview/*": ["../grpcview/*"]
    }
  },
  "include": ["src"]
}
