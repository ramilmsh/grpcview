load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@bazel_skylib//lib:partial.bzl", "partial")

ts_project(
    name = "tree",
    srcs = [
        "RenameInput.tsx",
        "Tree.tsx",
        "TreeRow.tsx",
        "dispatch.ts",
        "dnd.ts",
        "flatten.ts",
        "icon-map.tsx",
        "keymap.ts",
        "navigate.ts",
        "platform.ts",
        "selection.ts",
        "types.ts",
        "useTreeState.ts",
    ],
    # not type-check only (see //ui/src:app's comment).
    declaration = True,  # keep: sibling ts_project targets type-check @/* path-aliased
    no_emit = False,  # keep: this repo compiles TS to real JS for esbuild to bundle,
    # imports against this target's .d.ts output (see //ui/src:app's comment).
    preserve_jsx = False,
    resolve_json_module = True,
    # keep: swc emits the JS; tsc (declaration = True) stays only for
    # declaration-only type-checking.
    transpiler = partial.make(
        swc,
        swcrc = "//ui:.swcrc",
    ),
    tsconfig = ":tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//ui:node_modules/@types/react",
        "//ui:node_modules/clsx",
        "//ui:node_modules/react",
        "//ui/src/components/ui",
    ],
)

ts_project(
    name = "tree_tests",
    testonly = True,
    srcs = [
        "RenameInput.test.ts",
        "Tree.click-guard.test.ts",
        "Tree.keydown-guard.test.ts",
        "Tree.portable.test.tsx",
        "TreeRow.dnd.test.tsx",
        "dispatch.test.ts",
        "dnd.test.ts",
        "flatten.test.ts",
        "keymap.test.ts",
        "navigate.test.ts",
        "selection.test.ts",
    ],
    declaration = True,
    no_emit = False,  # keep: this repo compiles TS to real JS for esbuild to bundle,
    # not type-check only (see //ui/src:app's comment).
    preserve_jsx = False,
    resolve_json_module = True,
    # keep: swc emits the JS; tsc (declaration = True) stays only for
    # declaration-only type-checking.
    transpiler = partial.make(
        swc,
        swcrc = "//ui:.swcrc",
    ),
    tsconfig = ":tsconfig",
    deps = [
        ":tree",
        "//ui:node_modules/@types/node",
        "//ui:node_modules/@types/react",
        "//ui:node_modules/@types/react-dom",
        "//ui:node_modules/expect",
        "//ui:node_modules/jest-mock",
        "//ui:node_modules/react",
        "//ui:node_modules/react-dom",
    ],
)

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = [":__subpackages__"],
    deps = [
        "//ui:node_modules/@types/node",
        "//ui:tsconfig",
    ],
)
