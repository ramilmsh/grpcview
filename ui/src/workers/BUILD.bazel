load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@bazel_skylib//lib:partial.bzl", "partial")

ts_project(
    name = "workers",
    srcs = [
        "editor-worker-entry.ts",
        "json-worker-entry.ts",
        "ts-worker-entry.ts",
    ],
    # not type-check only (see //ui/src:app's comment).
    declaration = True,  # keep: sibling ts_project targets type-check @/* path-aliased
    no_emit = False,  # keep: this repo compiles TS to real JS for esbuild to bundle,
    # imports against this target's .d.ts output (see //ui/src:app's comment).
    preserve_jsx = False,
    resolve_json_module = True,
    # keep: swc emits the JS; tsc (declaration = True) stays only for
    # declaration-only type-checking.
    transpiler = partial.make(
        swc,
        swcrc = "//ui:.swcrc",
    ),
    tsconfig = "//ui:tsconfig",
    visibility = ["//visibility:public"],
    deps = ["//ui:node_modules/monaco-editor"],
)

# Each Monaco worker gets its own bundle: monaco's getWorkerUrl (see
# //ui/src/theme:monaco-nocturne.ts) loads these as plain classic scripts (not
# modules), one per language service. The *-entry.ts files exist purely so these
# entry_points are ordinary local source rather than reaching into node_modules
# (esbuild's entry_point/srcs must be co-located in this package — see
# //ui/src:app's comment).
# keep
esbuild(
    name = "editor_worker",
    entry_point = "editor-worker-entry.ts",
    format = "iife",
    minify = True,
    output = "dist/editor.worker.js",
    platform = "browser",
    target = ["es2020"],
    visibility = ["//ui/src:__pkg__"],
    deps = [":workers"],
)

# keep
esbuild(
    name = "json_worker",
    entry_point = "json-worker-entry.ts",
    format = "iife",
    minify = True,
    output = "dist/json.worker.js",
    platform = "browser",
    target = ["es2020"],
    visibility = ["//ui/src:__pkg__"],
    deps = [":workers"],
)

# keep
esbuild(
    name = "ts_worker",
    entry_point = "ts-worker-entry.ts",
    format = "iife",
    minify = True,
    output = "dist/ts.worker.js",
    platform = "browser",
    target = ["es2020"],
    visibility = ["//ui/src:__pkg__"],
    deps = [":workers"],
)
