load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@bazel_skylib//lib:partial.bzl", "partial")

ts_project(
    name = "theme",
    srcs = ["monaco-nocturne.ts"],
    # not type-check only (see //ui/src:app's comment).
    declaration = True,  # keep: sibling ts_project targets type-check @/* path-aliased
    no_emit = False,  # keep: this repo compiles TS to real JS for esbuild to bundle,
    # imports against this target's .d.ts output (see //ui/src:app's comment).
    preserve_jsx = False,
    resolve_json_module = True,
    # keep: swc emits the JS; tsc (declaration = True) stays only for
    # declaration-only type-checking.
    transpiler = partial.make(
        swc,
        swcrc = "//ui:.swcrc",
    ),
    tsconfig = "//ui:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//ui:node_modules/@monaco-editor/react",
        "//ui:node_modules/monaco-editor",
    ],
)

# The theme layer (fonts + nocturne + app-tokens) is plain CSS bundled straight
# from theme.css's @imports — not JS-imported from main.tsx, so gazelle's
# ts_project asset tracking (same-package files only) never has to reach across
# the ui/src -> ui/src/theme package boundary. See //ui/src's :app and :dist for
# the rest of the release bundle.
# keep
esbuild(
    name = "theme_css",
    srcs = [
        "app-tokens.css",
        "fonts.css",
        "nocturne.css",
    ] + glob(["fonts/**"]),
    config = "esbuild.config.mjs",
    entry_point = "theme.css",
    output = "dist/theme.css",
    platform = "browser",
    visibility = ["//ui/src:__pkg__"],
)
