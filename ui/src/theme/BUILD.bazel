load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("//ui:defs.bzl", "ts_project")

ts_project(
    name = "theme",
    srcs = ["monaco-nocturne.ts"],
    declaration = True,
    no_emit = False,
    preserve_jsx = False,
    resolve_json_module = True,
    tsconfig = "//ui:tsconfig",
    visibility = ["//visibility:public"],
    deps = [
        "//ui:node_modules/@monaco-editor/react",
        "//ui:node_modules/monaco-editor",
    ],
)

esbuild(
    name = "theme_css",
    srcs = [
        "app-tokens.css",
        "fonts.css",
        "nocturne.css",
    ] + glob(["fonts/**"]),
    entry_point = "theme.css",
    # Vendored font files are referenced by fonts.css's plain url(...), and
    # esbuild has no loader for binary files by default.
    #
    # "dataurl", not "file": the "file" loader emits a content-hashed sibling
    # (inter-latin-wght-normal-NRMW37G5.woff2) whose name is not knowable at
    # analysis time, so it cannot be declared as a rule output and bazel
    # throws it away — leaving main.css pointing at a 404 and the app on
    # fallback fonts. Inlining costs ~33% on ~88KB of woff2, in a bundle that
    # is embedded into the Go binary and served from memory anyway.
    loader = {".woff2": "dataurl"},
    output = "dist/theme.css",
    platform = "browser",
    visibility = ["//ui/src:__pkg__"],
)
