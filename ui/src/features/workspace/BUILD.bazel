load("@aspect_rules_swc//swc:defs.bzl", "swc")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@bazel_skylib//lib:partial.bzl", "partial")

ts_project(
    name = "workspace",
    srcs = [
        "CollectionPanel.tsx",
        "Editor.tsx",
        "FolderMetadataDialog.tsx",
        "JsonViewer.tsx",
        "MessageTab.tsx",
        "MessagesTab.tsx",
        "MetadataEditor.tsx",
        "MetadataTab.tsx",
        "MethodHeader.tsx",
        "MethodPickerModal.tsx",
        "MiddlewareTab.tsx",
        "NewCollectionDialog.tsx",
        "NoCollection.tsx",
        "RenameCollectionDialog.tsx",
        "RequestPane.tsx",
        "RequestTabs.tsx",
        "RequestWorkspace.tsx",
        "ResponsePane.tsx",
        "TargetBar.tsx",
        "TypesModal.tsx",
        "WorkspaceView.tsx",
        "auto-import.ts",
        "body-wrapper.ts",
        "collection-menu.ts",
        "collection-path.ts",
        "collection-switcher.ts",
        "delete-confirm.ts",
        "gv-requests.ts",
        "gv-types.ts",
        "import-block.ts",
        "metadata-wrapper.ts",
        "module-auto-import.ts",
        "module-sniff.ts",
        "module-specifier.ts",
