load("@aspect_gazelle_prebuilt//:def.bzl", "aspect_gazelle")
load("@multitool//:tools.bzl", "TOOLS")
load("@rules_go//proto:compiler.bzl", "go_proto_compiler")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_library.bzl", "sh_library")

aspect_gazelle(
    name = "gazelle",
    languages = [
        "go",
        "proto",
        "js",
        "buf",
    ],
    repo_config = "@bazel_gazelle_go_repository_config//:WORKSPACE",
    visibility = ["//:__pkg__"],
    with_check = True,
)

sh_binary(
    name = "release",
    srcs = ["release.sh"],
    data = [
        TOOLS["gh"],
        "//service/cmd:release",
    ],
    deps = ["@rules_shell//shell/runfiles"],
)

# Not sh_binary: these are invoked by path (--workspace_status_command, gopackagesdriver,
# and release.sh's `tools/version.sh`), never as a Bazel target. sh_library exists purely
# so the shellcheck lint aspect has something to visit.
sh_library(
    name = "version",
    srcs = ["version.sh"],
)

sh_library(
    name = "workspace_status",
    srcs = ["workspace_status.sh"],
)

sh_library(
    name = "gopackagesdriver",
    srcs = ["gopackagesdriver.sh"],
)

go_proto_compiler(
    name = "connect_go_proto_compiler",
    options = ["package_suffix"],
    plugin = "@com_connectrpc_connect//cmd/protoc-gen-connect-go:protoc-gen-connect-go",
    suffix = ".connect.go",
    visibility = ["//visibility:public"],
    deps = ["@com_connectrpc_connect//:go_default_library"],
)
