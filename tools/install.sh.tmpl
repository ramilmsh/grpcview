#!/bin/sh
set -eu

VERSION=@VERSION@
BASE_URL=@BASE_URL@
BIN_DIR=

SHA256SUMS=$(cat <<'GRPCVIEW_SHA256SUMS_EOF'
@SHA256SUMS@
GRPCVIEW_SHA256SUMS_EOF
)

usage() {
    cat >&2 <<EOF
usage: install.sh [options]

  pinned to grpcview $VERSION from $BASE_URL

  --bin-dir DIR   install into DIR instead of the first writable default
  --list          print the resolved asset, install nothing
EOF
    exit 2
}

list_only=false

while [ $# -gt 0 ]; do
    case "$1" in
    --bin-dir)
        BIN_DIR=${2:-}
        shift 2
        ;;
    --list)
        list_only=true
        shift
        ;;
    -h | --help) usage ;;
    *)
        echo "unknown argument: $1" >&2
        usage
        ;;
    esac
done

die() {
    echo "error: $*" >&2
    exit 1
}

case "$BASE_URL" in
http://* | https://*) ;;
*) die "tools/install.sh.tmpl is a template; render it with tools/release.sh, or use a published install.sh" ;;
esac
BASE_URL=${BASE_URL%/}

if command -v curl >/dev/null 2>&1; then
    fetch() { curl -fsSL "$1" -o "$2"; }
elif command -v wget >/dev/null 2>&1; then
    fetch() { wget -qO "$2" "$1"; }
else
    die "need curl or wget"
fi

if command -v sha256sum >/dev/null 2>&1; then
    sha256() { sha256sum "$1" | cut -d' ' -f1; }
elif command -v shasum >/dev/null 2>&1; then
    sha256() { shasum -a 256 "$1" | cut -d' ' -f1; }
else
    die "need sha256sum or shasum"
fi

case "$(uname -s)" in
Darwin) os=darwin ;;
Linux) os=linux ;;
*) die "unsupported operating system: $(uname -s)" ;;
esac

case "$(uname -m)" in
x86_64 | amd64) arch=amd64 ;;
arm64 | aarch64) arch=arm64 ;;
*) die "unsupported architecture: $(uname -m)" ;;
esac

asset="grpcview_${os}_${arch}"

if [ "$list_only" = true ]; then
    echo "version: $VERSION"
    echo "asset:   $BASE_URL/$VERSION/$asset"
    exit 0
fi

if [ -z "$BIN_DIR" ]; then
    for candidate in /usr/local/bin "$HOME/.local/bin"; do
        if [ -w "$candidate" ]; then
            BIN_DIR=$candidate
            break
        fi
    done
    BIN_DIR=${BIN_DIR:-$HOME/.local/bin}
fi

echo "==> grpcview $VERSION ($os/$arch) -> $BIN_DIR/grpcview"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT INT TERM

fetch "$BASE_URL/$VERSION/$asset" "$tmp/$asset" ||
    die "cannot download $asset of $VERSION"

expected=$(printf '%s\n' "$SHA256SUMS" | awk -v a="$asset" '$2 == a || $2 == "*" a {print $1}')
[ -n "$expected" ] || die "SHA256SUMS has no entry for $asset"

actual=$(sha256 "$tmp/$asset")
[ "$expected" = "$actual" ] ||
    die "checksum mismatch for $asset: expected $expected, got $actual"

mkdir -p "$BIN_DIR" || die "cannot create $BIN_DIR"
[ -w "$BIN_DIR" ] || die "$BIN_DIR is not writable; re-run with --bin-dir DIR, or as root"

staged="$BIN_DIR/.grpcview.install.$$"
cp "$tmp/$asset" "$staged"
chmod 0755 "$staged"
mv -f "$staged" "$BIN_DIR/grpcview"

echo "installed $BIN_DIR/grpcview"
echo "uninstall: $BIN_DIR/grpcview uninstall"

path_hint() {
    echo "note: $BIN_DIR is not on PATH; add it with" >&2
    case "${SHELL##*/}" in
    fish)
        echo "  fish_add_path $BIN_DIR" >&2
        ;;
    zsh)
        printf '  export PATH="%s:$PATH"    # add to ~/.zshrc to persist\n' "$BIN_DIR" >&2
        ;;
    bash)
        case "$(uname -s)" in
        Darwin) rc=~/.bash_profile ;;
        *) rc=~/.bashrc ;;
        esac
        printf '  export PATH="%s:$PATH"    # add to %s to persist\n' "$BIN_DIR" "$rc" >&2
        ;;
    tcsh | csh)
        printf '  setenv PATH "%s:$PATH"    # add to ~/.cshrc to persist\n' "$BIN_DIR" >&2
        ;;
    *)
        printf '  export PATH="%s:$PATH"\n' "$BIN_DIR" >&2
        ;;
    esac
}

resolved=$(command -v grpcview 2>/dev/null || true)
if [ "$resolved" != "$BIN_DIR/grpcview" ]; then
    if [ -n "$resolved" ]; then
        echo "note: \`grpcview\` on PATH is $resolved, which shadows the copy just installed" >&2
    else
        path_hint
    fi
fi
